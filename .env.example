PORT=2002
HOST=203.175.125.151
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET=your_admin_secret_here

# SEKALIPAY CREDENTIALS
SEKALIPAY_API_KEY=your_sekalipay_api_key
SEKALIPAY_WEBHOOK_SECRET=your_sekalipay_webhook_secret

# DATABASE CONFIG
# Opsi 1: Supabase PostgreSQL (Direkomendasikan)
# Dapatkan URI ini di Dashboard Supabase -> Project Settings -> Database -> Connection string -> URI (Pooler port 6543 atau direct 5432)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Opsi 2: SQLite lokal (Fallback default jika SUPABASE_DB_URL tidak diisi)
DATABASE_FILE=data.sqlite

# CLOUDFLARE TUNNEL
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# FINCLOUD DYNAMIC QRIS API
FINCLOUD_API_KEY=your_fincloud_api_key_here
FINCLOUD_BASE_URL=https://fincloud.my.id

